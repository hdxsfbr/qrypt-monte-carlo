# Copy to .env (git-ignored) for local runs. Never commit the real file.
# Qrypt entropy token from https://portal.qrypt.com (only needed for live calls; tests use a mock).
QRYPT_API_KEY=replace-with-your-qrypt-token
# Bearer key that callers send to the deployed API (make one with: python3 -c "import secrets;print(secrets.token_urlsafe(32))").
API_KEY=replace-with-a-long-random-string
# AWS CLI profile for the project account.
AWS_PROFILE=qmc
AWS_REGION=us-east-1
