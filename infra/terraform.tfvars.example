# Copy to terraform.tfvars (git-ignored) and fill in. Never commit terraform.tfvars.
alert_email = "you@example.com"

# AWS accounts Terraform may touch (a guard against using the wrong CLI profile). Set to your own account id.
# allowed_account_ids = ["123456789012"]

# While the account's Lambda concurrency quota is 10 (see docs/DESIGN.md, EC-6 account limit):
# reserve_concurrency = false
# worker_concurrency  = 5
