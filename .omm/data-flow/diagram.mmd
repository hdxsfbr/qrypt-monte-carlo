    shard-simulation -->|"sum, sum_sq, n"| shard-results
    shard-results -->|"fsum in shard-index order, discount e^-rT"| job-estimate
    job-estimate -->|"estimate_hex compared with original"| replay-check
    master-seed -->|"replay reuses stored seed, no new entropy"| shard-seeds

