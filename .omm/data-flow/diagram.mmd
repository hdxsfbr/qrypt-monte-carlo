graph LR
    entropy-block["Entropy Block\n1024 bytes from Qrypt"]
    master-seed["Master Seed\nseeds.py master_seed_from_block"]
    shard-seeds["Shard Seeds\nseeds.py shard_seed (HKDF)"]
    shard-simulation["Shard Simulation\nsimulate.py simulate_shard"]
